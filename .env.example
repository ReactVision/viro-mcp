# viro-mcp — environment variables. Copy to .env (gitignored).

# ─── Server ──────────────────────────────────────────────────────────────────

# HTTP port. Default: 3000.
# PORT=3000

# Bind address. Default: 127.0.0.1. The local server has no authentication, so
# only widen this behind something that adds it.
# HOST=127.0.0.1

# Download URL for a pre-built knowledge base (knowledge/reactviro.db), used when
# the file is not on disk. Leave unset if you build it with `npm run index`.
# KB_URL=

# ─── Indexer (`npm run index`) ───────────────────────────────────────────────

# Parent of the ViroWorkspace/ checkout. Default: two levels above the working
# directory, i.e. right when run from ViroWorkspace/viro-mcp. Repositories
# that are missing are skipped.
# PROJECT_DIR=/path/to/parent

# Optional OpenAI-compatible embeddings endpoint (POST <url>/embeddings) for
# hybrid search. Without a key, indexing skips embeddings and search is pure
# full-text (SQLite FTS5); everything else works the same.
# AI_GATEWAY_URL=https://your-gateway.example/v1
# AI_GATEWAY_KEY=
# EMBED_MODEL=nomic-embed-text
